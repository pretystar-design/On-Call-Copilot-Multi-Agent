# On-Call Copilot — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env          # Linux/Mac
#   copy .env.example .env        # Windows
#
# IMPORTANT: Never commit .env — it is excluded via .gitignore.

# ──────────────────────────────────────────────────────────────
# Required for Multi-Agent Mode (main.py) — choose ONE auth method
# ──────────────────────────────────────────────────────────────

# Option A: Standard Azure OpenAI (no Foundry project needed)
# Set these two to run main.py using the plain Azure OpenAI API.
# This avoids loading the Foundry AIProjectClient entirely.
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=model-router

# Option B: Foundry project endpoint (requires Foundry hosted-agent setup).
# Comment out the AZURE_OPENAI_ENDPOINT + API_KEY above if using this path.
# AZURE_AI_PROJECT_ENDPOINT=https://<hosted-account>.services.ai.azure.com/api/projects/<hosted-project>
# AZURE_MODEL_PROJECT_ENDPOINT=https://<model-account>.services.ai.azure.com/api/projects/<model-project>

# Model Router deployment name (used by scripts and telemetry).
MODEL_ROUTER_DEPLOYMENT=model-router

# ──────────────────────────────────────────────────────────────
# Required for UI (ui/server.py) and SDK scripts
# ──────────────────────────────────────────────────────────────

# Azure deployment metadata for hosted-agent deployment.
AZURE_TENANT_ID=<your-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<hosted-agent-resource-group>
AZURE_LOCATION=<hosted-agent-region>
AZURE_AI_PROJECT_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<hosted-account>/projects/<hosted-project>

# ──────────────────────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────────────────────

# Agent name for SDK scripts (default: oncall-copilot)
# AGENT_NAME=oncall-copilot

# Agent version for SDK scripts (default: latest)
# AGENT_VERSION=latest

# Azure Container Registry settings for hosted-agent deployment.
AZURE_CONTAINER_REGISTRY_ENDPOINT=taijidev.azurecr.io
ACR_IMAGE=test/oncall-copilot:agent-framework-1.2.0

# Set to "true" when deploying/running as a Foundry hosted agent.
ENABLE_HOSTED_AGENTS=true

# GCP project ID for topology discovery (optional, inferred from auth if unset)
# GCP_PROJECT_ID=

# Set to "true" to run FastAPI mock mode without Azure credentials
# MOCK_MODE=false

# Topology cache directory (default: ~/.oncall-copilot/topology)
# TOPOLOGY_CACHE_DIR=~/.oncall-copilot/topology

# Topology cache TTL in seconds (default: 86400)
# TOPOLOGY_CACHE_TTL=86400

# ──────────────────────────────────────────────────────────────
# MCP (Model Context Protocol) Integration
# ──────────────────────────────────────────────────────────────

# JSON array of MCP server definitions for MCPStdioTool.
# Each entry supports: name, command, args, env
# Example:
#   MCP_SERVERS='[{"name":"ado","command":"npx","args":["-y","@azure-devops/mcp","<org>","--authentication","envvar"],"env":{"ADO_MCP_AUTH_TOKEN":"<pat>"}}]'
# MCP_SERVERS=

# ──────────────────────────────────────────────────────────────
# Agent Skills Integration (generic catalog registry)
# ──────────────────────────────────────────────────────────────

# New generic env var pattern: SKILL_CATALOG__<NAME>__DIR
# Takes priority over legacy per-catalog vars (ELASTIC_SKILLS_DIR, MS_SKILLS_DIR)
# SKILL_CATALOG__ELASTIC__DIR=skills/elastic/
# SKILL_CATALOG__MICROSOFT__DIR=skills/microsoft/

# Legacy per-catalog env vars (used as fallback if new generic vars are unset)
# ELASTIC_SKILLS_DIR=skills/elastic/
# MS_SKILLS_DIR=skills/microsoft/

# Elastic Cloud endpoint for skill operations (optional, required for cloud skills)
# ELASTIC_CLOUD_ENDPOINT=https://<your-deployment>.elastic-cloud.com
# ELASTIC_API_KEY=<your-elastic-api-key>

# Logging level (default: INFO)
# LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────
# RAG (Retrieval-Augmented Generation) — Knowledge Base Search
# ──────────────────────────────────────────────────────────────
#
# RAG gives agents the ability to search runbooks, PIRs, and playbooks.
# Two backends are supported:
#   1. Azure AI Search (production) — set RAG_SEARCH_ENDPOINT
#   2. In-memory (local dev/demo) — with seed docs from knowledge/ directory
#
# When RAG_SEARCH_ENDPOINT is unset, the app falls back to in-memory search
# using markdown files in the knowledge/ directory at the project root.
# Set RAG__DISABLE=true to disable RAG entirely.

# Azure AI Search endpoint (required for production backend)
# Example: https://<service>.search.windows.net
# RAG_SEARCH_ENDPOINT=

# Azure AI Search admin API key (optional — uses DefaultAzureCredential if unset)
# RAG_SEARCH_API_KEY=

# Azure AI Search index name (default: knowledge-index)
# RAG_SEARCH_INDEX_NAME=knowledge-index

# OpenAI embedding model for vectorization (default: text-embedding-3-small)
# Reuses AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_API_KEY from above.
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# Embedding vector dimensions (must match the model; default: 1536)
# RAG_EMBEDDING_DIMENSIONS=1536

# Set to 1, true, or yes to disable RAG without removing configuration
# RAG__DISABLE=false

# ──────────────────────────────────────────────────────────────
# SSO (Single Sign-On) with Azure AD
# ──────────────────────────────────────────────────────────────

# Enable SSO authentication (default: true)
# Set to "false" to disable SSO and allow anonymous access
# SSO_ENABLED=true

# Azure AD client ID (required for SSO)
# Register an app in Azure AD: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# SSO_CLIENT_ID=<your-app-client-id>

# Azure AD tenant ID (optional, defaults to AZURE_TENANT_ID)
# Use "common" for multi-tenant apps
# SSO_TENANT_ID=<your-tenant-id>

# Redirect URI after authentication (must match Azure AD app registration)
# Default: http://localhost:7860/auth/callback
# SSO_REDIRECT_URI=http://localhost:7860/auth/callback

# Session secret key for encrypting session tokens (auto-generated if unset)
# Recommended to set a fixed value for production
# SSO_SECRET_KEY=<your-secret-key>

# Session lifetime in hours (default: 8)
# SSO_SESSION_LIFETIME_HOURS=8
